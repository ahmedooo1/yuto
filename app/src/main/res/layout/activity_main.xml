<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <!-- Marque : le mot et une barre "verrou" qui change de couleur selon l'état -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="64sp" />

            <View
                android:id="@+id/brandBar"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="14dp"
                android:layout_weight="1"
                android:background="@color/lime" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/tagline"
            android:textColor="@color/muted"
            android:textSize="18sp" />

        <!-- Verrou de stationnement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/status_title"
                android:textColor="@color/text"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/allowButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_primary"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/allow"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Compte YouTube -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/login_title"
                android:textColor="@color/text"
                android:textSize="21sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/login_text"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_ghost"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/login_button"
                android:textAllCaps="false"
                android:textColor="@color/lime"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Dans la voiture -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/car_title"
            android:textColor="@color/text"
            android:textSize="28sp" />

        <LinearLayout
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="@string/credit"
            android:textColor="#5B6676"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
